# netbox/.env.example -- variable names and NON-SENSITIVE placeholder values
# only. This file is tracked in Git.
#
# The real runtime file is `netbox/.env`, generated by
# `netbox/scripts/bootstrap_netbox.sh` with freshly-random secrets on first
# run. `netbox/.env` is listed in .gitignore and must never be committed.
#
# See docs/NETBOX_IPAM.md for the full explanation of every variable below.

# --- PostgreSQL --------------------------------------------------------
POSTGRES_DB=netbox
POSTGRES_USER=netbox
POSTGRES_PASSWORD=changeme-postgres-password
# NetBox's own DB_* settings must reference the same database/credentials.
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=changeme-postgres-password
DB_HOST=postgres

# --- Redis (task queue) -------------------------------------------------
REDIS_HOST=redis
REDIS_PASSWORD=changeme-redis-password

# --- Redis (cache) -------------------------------------------------------
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PASSWORD=changeme-redis-cache-password

# --- NetBox/Django core ---------------------------------------------------
# SECRET_KEY: Django cryptographic signing key. Must be a long, random
# string (NetBox recommends 50+ mixed characters). Generated by the
# bootstrap script; never reuse this placeholder.
SECRET_KEY=changeme-django-secret-key-at-least-50-characters-long
# API_TOKEN_PEPPER_1: server-side secret NetBox mixes into the HMAC digest
# it stores for every v2 API token (NetBox no longer stores tokens in
# plaintext). Required before any API token can be created or validated.
API_TOKEN_PEPPER_1=changeme-api-token-pepper

# --- Initial administrator bootstrap (see docker/super_user.py in the
# netboxcommunity/netbox image; idempotent -- a no-op once the named user
# already exists) ----------------------------------------------------------
SKIP_SUPERUSER=false
SUPERUSER_NAME=nmas-admin
SUPERUSER_EMAIL=nmas-admin@example.invalid
SUPERUSER_PASSWORD=changeme-superuser-password
# Intentionally NOT SUPERUSER_API_TOKEN/SUPERUSER_API_KEY here: NetBox 4.7's
# v2 tokens are stored as an HMAC digest generated from a matched (key,
# token) pair produced together by NetBox itself. Pre-supplying our own pair
# through these environment variables would require reproducing that
# generation/hashing scheme outside NetBox to guarantee validity, which
# netbox/scripts/ensure_api_token.py deliberately avoids -- it instead asks
# NetBox's own Django ORM (via `manage.py shell`, a supported mechanism) to
# generate a real token for SUPERUSER_NAME the first time the stack starts.

# --- modules/netbox_ipam.py client configuration --------------------------
# Populated automatically once netbox/scripts/ensure_api_token.py creates
# the token above; safe to leave NETBOX_TOKEN blank until then.
NETBOX_URL=http://127.0.0.1:8000
NETBOX_TOKEN=
NETBOX_TIMEOUT=10
NETBOX_VERIFY_SSL=true
