# /etc/nmas/nmas-web.env -- runtime environment for nmas-web.service (V2 Phase 1).
# PLACEHOLDERS ONLY.  The installer writes the real file (root:<run group>, 0640) with a generated SECRET_KEY that is
# never printed.  Never commit the real file.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=<generated-by-installer>
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,nmas.local
DJANGO_BEHIND_TRUSTED_PROXY=true
NMAS_TRUSTED_PROXY_IPS=127.0.0.1,::1
# Add the Cloudflare hostname once the tunnel exists, e.g. https://nmas.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SESSION_COOKIE_SECURE=false
NMAS_APP_MFA_REQUIRED=true
# Optional dedicated Fernet key for website-MFA seeds (otherwise derived from DJANGO_SECRET_KEY).
NMAS_APP_MFA_KEY=
DJANGO_STATIC_ROOT=/var/lib/nmas/static
GRAFANA_BASE_URL=http://127.0.0.1:3000
GRAFANA_EMBED_ENABLED=true
# Optional: the traffic runner's Unix socket (default /run/nmas-traffic-runner/runner.sock, see nmas-traffic-runner.socket).
NMAS_TRAFFIC_RUNNER_SOCKET=
