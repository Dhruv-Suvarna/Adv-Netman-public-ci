[Unit]
Description=NMAS Troubleshooter automatic incident intake (monitoring -> case -> Codex dispatch; read-only)
After=network-online.target nmas-web.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=student
Group=student
EnvironmentFile=/etc/nmas/nmas-web.env
Environment=NMAS_TS_ROUTE_INTENT_FILE=/home/student/Scripts/clab_dualstack_lab-deploy/web/core/tests/fixtures/troubleshooting_routing/acceptance-intent-v1.json
Environment=NMAS_TS_TOPOLOGY_REVISION=adf5fb5ac3c8bc0cbbc058595ee1207075b9cb30
Environment=NMAS_TS_ROUTE_INTENT_MAX_AGE_SECONDS=60
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=nmas-ts-intake
WorkingDirectory=/home/student/Scripts/clab_dualstack_lab-deploy/web
ExecStart=/home/student/Scripts/.venv/bin/python manage.py nmas_ts_intake --watch --interval 10
Restart=always
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
