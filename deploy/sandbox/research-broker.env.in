NMAS_TS_RESEARCH_SOCKET=/run/nmas-ts-research/worker.sock
NMAS_TS_RESEARCH_SOCKET_GROUP=nmas-ts-research-ipc
NMAS_TS_RESEARCH_CLIENT_UID=@RUNTIME_UID@
NMAS_TS_RESEARCH_IPC_KEY=@RESEARCH_IPC_KEY@
NMAS_TS_RESEARCH_REPLAY_DB=/var/lib/nmas-ts-research/replay.sqlite3
NMAS_TS_RESEARCH_AUDIT_LOG=/var/log/nmas-ts-research/audit.jsonl
NMAS_TS_RESEARCH_ALLOWED_DESTINATIONS=@RESEARCH_DESTINATIONS_JSON@
NMAS_TS_RESEARCH_TIMEOUT=8
NMAS_TS_RESEARCH_MAX_BYTES=262144
NMAS_TS_RESEARCH_MAX_REDIRECTS=3
