# /etc/nmas/model-broker-@INSTANCE@.env   root:nmas-ts-model-@INSTANCE@ 0640
# One file per broker instance (codex, claude-a, claude-b).  The provider credential and the IPC key in this file
# are distinct per instance and are never placed in the Troubleshooter runtime, the website or any model-visible text.
NMAS_TS_MODEL_AGENT=@AGENT@
NMAS_TS_MODEL_BACKEND=@BACKEND@
NMAS_TS_MODEL_PROVIDER=@MODEL_PROVIDER_NAME@
NMAS_TS_MODEL_ID=@MODEL_ID@
NMAS_TS_MODEL_VERSION=@MODEL_VERSION@
NMAS_TS_MODEL_CLIENT_UID=@RUNTIME_UID@
NMAS_TS_MODEL_SOCKET_GROUP=nmas-ts-model-ipc
NMAS_TS_MODEL_IPC_KEY=@MODEL_IPC_KEY@
NMAS_TS_MODEL_PROVIDER_CREDENTIAL=@PROVIDER_CREDENTIAL@
NMAS_TS_MODEL_PROVIDER_TIMEOUT=50
NMAS_TS_MODEL_MAX_OUTPUT_TOKENS=16000
NMAS_TS_MODEL_EFFORT=medium
