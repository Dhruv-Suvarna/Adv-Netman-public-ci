# One independently authorized research activation over a VM-local veth.
# Values are deliberately unresolved; do not infer them from VM1 routes,
# resolvers or reachability. No address outside VM1 is allocated: the link
# prefix is private to VM1 and egress is source-NATed behind VM1's existing
# external address. A host route is not evidence of public reachability; enable
# a family only where a public path through EGRESS_INTERFACE is confirmed.
NAMESPACE=research
ACTIVATION_ID=@RESEARCH_ACTIVATION_ID@
AUTHORIZATION_APPROVED=@RESEARCH_AUTHORIZATION_APPROVED_YES@
AUTHORIZATION_ID=@RESEARCH_AUTHORIZATION_ID@
# Existing host interface towards the public internet. Never modified.
EGRESS_INTERFACE=@RESEARCH_EGRESS_INTERFACE@
HOST_NETWORKING_APPROVAL_ID=@RESEARCH_HOST_NETWORKING_APPROVAL_ID@
FIREWALL_POLICY_APPROVAL_ID=@RESEARCH_FIREWALL_POLICY_APPROVAL_ID@
RESEARCH_EGRESS_APPROVAL_ID=@RESEARCH_EGRESS_APPROVAL_ID@
NFT_POLICY=/etc/nmas/research-egress.nft
NFT_POLICY_SHA256=@RESEARCH_NFT_SHA256@
# Additional protected networks beyond the built-in private/special set, e.g.
# the institution's public ranges. Space-separated CIDRs; may be empty.
EXTRA_DENY_CIDRS=@RESEARCH_EXTRA_DENY_CIDRS_OR_EMPTY@
# NAT is "masquerade" or one exact existing address on EGRESS_INTERFACE.
IPV4_MODE=@RESEARCH_IPV4_ENABLED_OR_DISABLED@
IPV4_LINK_CIDR=@RESEARCH_IPV4_LINK_CIDR_OR_EMPTY@
IPV4_GATEWAY=@RESEARCH_IPV4_GATEWAY_OR_EMPTY@
IPV4_NAT=@RESEARCH_IPV4_NAT_OR_EMPTY@
IPV4_NAT_APPROVAL_ID=@RESEARCH_IPV4_NAT_APPROVAL_ID_OR_EMPTY@
IPV4_FOREIGN_FORWARD_APPROVAL_ID=@RESEARCH_IPV4_FOREIGN_FORWARD_APPROVAL_ID_OR_EMPTY@
IPV6_MODE=@RESEARCH_IPV6_ENABLED_OR_DISABLED@
IPV6_LINK_CIDR=@RESEARCH_IPV6_LINK_CIDR_OR_EMPTY@
IPV6_GATEWAY=@RESEARCH_IPV6_GATEWAY_OR_EMPTY@
IPV6_NAT=@RESEARCH_IPV6_NAT_OR_EMPTY@
IPV6_NAT_APPROVAL_ID=@RESEARCH_IPV6_NAT_APPROVAL_ID_OR_EMPTY@
IPV6_FOREIGN_FORWARD_APPROVAL_ID=@RESEARCH_IPV6_FOREIGN_FORWARD_APPROVAL_ID_OR_EMPTY@
DNS_MODE=enabled
DNS_SERVERS=@RESEARCH_DNS_SERVERS_SPACE_SEPARATED@
DNS_TRANSPORTS=udp,tcp
# Exact reviewed public TCP/443 destinations resolved for the approved hosts.
# DNS answers outside this set fail closed in both the broker and nftables.
HTTPS_TARGETS=@RESEARCH_HTTPS_TARGETS_SPACE_SEPARATED@
