# One independently authorized diagnostic activation over a VM-local veth.
# Values are deliberately unresolved; do not infer them from VM1 routes,
# interfaces or reachability. No address outside VM1 is allocated: the link
# prefix is private to VM1 and devices see the existing NMAS management source.
NAMESPACE=diagnostic
ACTIVATION_ID=@DIAGNOSTIC_ACTIVATION_ID@
AUTHORIZATION_APPROVED=@DIAGNOSTIC_AUTHORIZATION_APPROVED_YES@
AUTHORIZATION_ID=@DIAGNOSTIC_AUTHORIZATION_ID@
# Existing host interface towards the Containerlab management LAN. Never modified.
EGRESS_INTERFACE=@DIAGNOSTIC_EGRESS_INTERFACE@
HOST_NETWORKING_APPROVAL_ID=@DIAGNOSTIC_HOST_NETWORKING_APPROVAL_ID@
FIREWALL_POLICY_APPROVAL_ID=@DIAGNOSTIC_FIREWALL_POLICY_APPROVAL_ID@
NFT_POLICY=/etc/nmas/diagnostic-egress.nft
NFT_POLICY_SHA256=@DIAGNOSTIC_NFT_SHA256@
# Exact approved ManagementPath tuples, e.g. tcp:192.0.2.1:22 tcp:[2001:db8::1]:22
# (render_policy.py emits this line as diagnostic-targets.env).
TARGETS=@DIAGNOSTIC_TARGETS_SPACE_SEPARATED@
# LINK_CIDR is the namespace end of a /30 or /31 (IPv4 link-local/private) or
# /126 or /127 (IPv6 ULA) that overlaps nothing on VM1. GATEWAY is the host end.
# NAT is the exact existing management source address on EGRESS_INTERFACE.
IPV4_MODE=@DIAGNOSTIC_IPV4_ENABLED_OR_DISABLED@
IPV4_LINK_CIDR=@DIAGNOSTIC_IPV4_LINK_CIDR_OR_EMPTY@
IPV4_GATEWAY=@DIAGNOSTIC_IPV4_GATEWAY_OR_EMPTY@
IPV4_NAT=@DIAGNOSTIC_IPV4_NAT_SOURCE_OR_EMPTY@
IPV4_NAT_APPROVAL_ID=@DIAGNOSTIC_IPV4_NAT_APPROVAL_ID_OR_EMPTY@
IPV4_FOREIGN_FORWARD_APPROVAL_ID=@DIAGNOSTIC_IPV4_FOREIGN_FORWARD_APPROVAL_ID_OR_EMPTY@
IPV6_MODE=@DIAGNOSTIC_IPV6_ENABLED_OR_DISABLED@
IPV6_LINK_CIDR=@DIAGNOSTIC_IPV6_LINK_CIDR_OR_EMPTY@
IPV6_GATEWAY=@DIAGNOSTIC_IPV6_GATEWAY_OR_EMPTY@
IPV6_NAT=@DIAGNOSTIC_IPV6_NAT_SOURCE_OR_EMPTY@
IPV6_NAT_APPROVAL_ID=@DIAGNOSTIC_IPV6_NAT_APPROVAL_ID_OR_EMPTY@
IPV6_FOREIGN_FORWARD_APPROVAL_ID=@DIAGNOSTIC_IPV6_FOREIGN_FORWARD_APPROVAL_ID_OR_EMPTY@
DNS_MODE=disabled
DNS_SERVERS=
DNS_TRANSPORTS=
