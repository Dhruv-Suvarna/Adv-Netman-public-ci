[Unit]
Description=NMAS completion-only model broker (%i)
After=network-online.target systemd-resolved.service
Wants=network-online.target
ConditionPathExists=/etc/nmas/model-broker-%i.env
ConditionPathExists=/opt/nmas-model/venv/bin/python
ConditionPathExists=/opt/nmas-model/current/web/core/services/troubleshooting/model_broker.py
StartLimitBurst=3
StartLimitIntervalSec=120s

[Service]
Type=simple
User=nmas-ts-model-%i
Group=nmas-ts-model-%i
SupplementaryGroups=nmas-ts-model-ipc
EnvironmentFile=/etc/nmas/model-broker-%i.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/nmas-model/venv/bin/python -s -m core.services.troubleshooting.model_broker
WorkingDirectory=/opt/nmas-model/current/web
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET
# Provider egress only.  Everything private, link-local, loopback, shared, multicast and all IPv6 is denied at the
# unit's cgroup; the single exception is the local systemd-resolved stub.  The broker therefore cannot reach VM1
# services, VM2, the campus network, Docker bridges, the Containerlab management LAN or any device.
IPAddressDeny=0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 224.0.0.0/3 ::/0
IPAddressAllow=127.0.0.53/32
SocketBindDeny=any
ReadOnlyPaths=/opt/nmas-model /etc/nmas/model-broker-%i.env
InaccessiblePaths=/run/docker.sock /var/run/docker.sock /run/containerd/containerd.sock -/etc/nmas/nmas-web.env -/etc/nmas/troubleshooter-device-worker.env -/etc/nmas/research-broker.env -/etc/nmas/troubleshooter-ipc-client.env -/var/lib/nmas-ts-diagnostic -/var/lib/nmas-ts-research -/var/lib/nmas-ts-runtime -/var/log/nmas-ts-diagnostic -/var/log/nmas-ts-research -/opt/nmas -/home
ReadWritePaths=/run/nmas-ts-model
StateDirectory=nmas-ts-model-%i
StateDirectoryMode=0700
LogsDirectory=nmas-ts-model-%i
LogsDirectoryMode=0750
UMask=0027
MemoryMax=512M
TasksMax=32
Restart=on-failure
RestartSec=5s

# Deliberately no [Install]: each broker is started only after its own provider credential has been enrolled.
