DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=@DEDICATED_WORKER_DJANGO_KEY@
NMAS_TS_BINDING=nmas-v1
NMAS_TS_DIAGNOSTIC_SOCKET=/run/nmas-ts-diagnostic/worker.sock
NMAS_TS_DIAGNOSTIC_SOCKET_GROUP=nmas-ts-diagnostic-ipc
NMAS_TS_DIAGNOSTIC_CLIENT_UID=@RUNTIME_UID@
NMAS_TS_DIAGNOSTIC_IPC_KEY=@DIAGNOSTIC_IPC_KEY@
NMAS_TS_DIAGNOSTIC_REPLAY_DB=/var/lib/nmas-ts-diagnostic/replay.sqlite3
NMAS_TS_DIAGNOSTIC_AUDIT_LOG=/var/log/nmas-ts-diagnostic/audit.jsonl
