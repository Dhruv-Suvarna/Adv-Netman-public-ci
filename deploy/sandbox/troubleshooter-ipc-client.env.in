NMAS_TS_DIAGNOSTIC_SOCKET=/run/nmas-ts-diagnostic/worker.sock
NMAS_TS_DIAGNOSTIC_IPC_KEY=@DIAGNOSTIC_IPC_KEY@
NMAS_TS_RESEARCH_SOCKET=/run/nmas-ts-research/worker.sock
NMAS_TS_RESEARCH_IPC_KEY=@RESEARCH_IPC_KEY@
NMAS_TS_BINDING=nmas-v1
NMAS_TS_TENANT=default
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=@DEDICATED_RUNTIME_DJANGO_KEY@
NMAS_TS_MODEL_SOCKET=/run/nmas-ts-model/provider.sock
NMAS_TS_MODEL_IPC_KEY=@MODEL_IPC_KEY@
NMAS_TS_MODEL_PROVIDER=@MODEL_PROVIDER_NAME@
NMAS_TS_MODEL_ID=@MODEL_ID@
NMAS_TS_MODEL_VERSION=@MODEL_VERSION@
NMAS_TS_MODEL_TIMEOUT=60
TROUBLESHOOTING_AI_PROVIDER=core.services.troubleshooting.model_provider.completion_only_provider
NMAS_TS_RUNTIME_DB_RESTRICTED=1
NMAS_TS_RUNTIME_DATABASE=/var/lib/nmas-ts-runtime/db.sqlite3
# Three-agent dispatch (nmas-troubleshooter-dispatch@): one distinct IPC key and pinned identity per fixed socket.
NMAS_TS_CODEX_MODEL_IPC_KEY=@CODEX_MODEL_IPC_KEY@
NMAS_TS_CODEX_MODEL_PROVIDER=@CODEX_MODEL_PROVIDER_NAME@
NMAS_TS_CODEX_MODEL_ID=@CODEX_MODEL_ID@
NMAS_TS_CODEX_MODEL_VERSION=@CODEX_MODEL_VERSION@
NMAS_TS_CLAUDEA_MODEL_IPC_KEY=@CLAUDEA_MODEL_IPC_KEY@
NMAS_TS_CLAUDEA_MODEL_PROVIDER=@CLAUDEA_MODEL_PROVIDER_NAME@
NMAS_TS_CLAUDEA_MODEL_ID=@CLAUDEA_MODEL_ID@
NMAS_TS_CLAUDEA_MODEL_VERSION=@CLAUDEA_MODEL_VERSION@
NMAS_TS_CLAUDEB_MODEL_IPC_KEY=@CLAUDEB_MODEL_IPC_KEY@
NMAS_TS_CLAUDEB_MODEL_PROVIDER=@CLAUDEB_MODEL_PROVIDER_NAME@
NMAS_TS_CLAUDEB_MODEL_ID=@CLAUDEB_MODEL_ID@
NMAS_TS_CLAUDEB_MODEL_VERSION=@CLAUDEB_MODEL_VERSION@
