[Unit]
Description=NMAS due managed-device credential rotation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=student
WorkingDirectory=@@DEPLOYMENT_ROOT@@
EnvironmentFile=@@DEPLOYMENT_ROOT@@/monitoring/runtime/credential-rotation.env
ExecStart=/home/student/Scripts/.venv/bin/python @@DEPLOYMENT_ROOT@@/web/manage.py rotate_due_credentials --json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@@DEPLOYMENT_ROOT@@/monitoring/runtime @@DEPLOYMENT_ROOT@@/web
