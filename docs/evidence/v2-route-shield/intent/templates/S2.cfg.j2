hostname S2
!
ip routing
ipv6 unicast-routing
!
vlan 10
   name USERS10
vlan 20
   name USERS20
vlan 30
   name IPV6_ONLY
vlan 99
   name RIP_TRANSIT
vlan 200
   name MANAGEMENT
!
ip virtual-router mac-address 001c.7300.0099
!
! Remove old IPIP configuration
no ipv6 route ::/0 nexthop-group IPIP-R2
no ipv6 route ::/0 nexthop-group IPIP-R1-BACKUP 200
no nexthop-group IPIP-R2
no nexthop-group IPIP-R1-BACKUP
no ip decap-group IPIP-DECAP
!
! Remove temporary troubleshooting route if present
no ip route 192.168.254.2/32 192.168.110.2
!
interface Ethernet1
   description RIP_IPV4_STATIC_IPV6_TO_R2
   no switchport
   ip address 192.168.110.3/31
   ipv6 address 2001:db8:110:2::2/64
!
interface Ethernet2
   description S2_S1_TRUNK
   switchport mode trunk
   switchport trunk allowed vlan 10,20,30,99
!
interface Ethernet3
   description H3_VLAN10
   switchport access vlan 10
   spanning-tree portfast
!
interface Ethernet4
   description H4_VLAN30
   switchport access vlan 30
   spanning-tree portfast
!
interface Ethernet5
   description MANAGEMENT
   switchport access vlan 200
   spanning-tree bpdufilter enable
!
interface Vlan200
   ip address 192.168.200.12/24
   ipv6 address 2001:db8:200::12/64
!
interface Vlan99
   ip address 192.168.110.5/31
!
no interface Loopback10
!
interface Vlan10
   ip address 192.168.10.3/24
   ip virtual-router address 192.168.10.1
   ipv6 address 2001:db8:10::3/64
   ipv6 virtual-router address 2001:db8:10::1
   ip helper-address {{ management.primary_dhcp_ipv4 }}
   ip helper-address {{ management.backup_dhcp_ipv4 }}
   ipv6 nd managed-config-flag
   ipv6 nd other-config-flag
   ipv6 nd prefix 2001:db8:10::/64 no-autoconfig
   ipv6 dhcp relay destination {{ management.primary_dhcp_ipv6 }}
   ipv6 dhcp relay destination {{ management.backup_dhcp_ipv6 }}
!
interface Vlan20
   ip address 192.168.20.3/24
   ip virtual-router address 192.168.20.1
   ipv6 address 2001:db8:20::3/64
   ipv6 virtual-router address 2001:db8:20::1
   ip helper-address {{ management.primary_dhcp_ipv4 }}
   ip helper-address {{ management.backup_dhcp_ipv4 }}
   ipv6 nd managed-config-flag
   ipv6 nd other-config-flag
   ipv6 nd prefix 2001:db8:20::/64 no-autoconfig
   ipv6 dhcp relay destination {{ management.primary_dhcp_ipv6 }}
   ipv6 dhcp relay destination {{ management.backup_dhcp_ipv6 }}
!
interface Vlan30
   no ip address
   ipv6 address 2001:db8:30::3/64
   ipv6 virtual-router address 2001:db8:30::1
   ipv6 nd managed-config-flag
   ipv6 nd other-config-flag
   ipv6 nd prefix 2001:db8:30::/64 no-autoconfig
   ipv6 dhcp relay destination {{ management.primary_dhcp_ipv6 }}
   ipv6 dhcp relay destination {{ management.backup_dhcp_ipv6 }}
!
router rip
   no network 192.168.254.12/32
   network 192.168.110.3/31
   network 192.168.110.5/31
   network 192.168.10.0/24
   network 192.168.20.0/24
!
! Baseline IS-IS access routing (NMAS baseline migration; docs/V2_LOSSLESS_ROUTE_SHIELD.md)
interface Vlan99
   ipv6 address 2001:db8:110:3::2/64
!
router isis NMAS
   net 49.0110.1921.6825.5012.00
   is-type level-2
   address-family ipv6 unicast
!
interface Ethernet1
   isis enable NMAS
   isis metric 10
interface Vlan99
   isis enable NMAS
   isis metric 10
!
interface Vlan10
   isis enable NMAS
   isis passive
interface Vlan20
   isis enable NMAS
   isis passive
interface Vlan30
   isis enable NMAS
   isis passive
!
