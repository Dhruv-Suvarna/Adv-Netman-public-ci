hostname S4
!
no ip routing
!
vlan 102
   name R1_R4
vlan 103
   name R2_R3
vlan 104
   name R2_R4
vlan 200
   name MANAGEMENT
!
interface Ethernet1
   description R4_TRUNK
   switchport mode trunk
   switchport trunk allowed vlan 102,104
!
interface Ethernet2
   description S4_S3_TRANSIT
   switchport mode trunk
   switchport trunk allowed vlan 102,103
!
interface Ethernet3
   description R2_TRUNK
   switchport mode trunk
   switchport trunk allowed vlan 103,104
!
interface Ethernet4
   description MANAGEMENT
   switchport access vlan 200
   spanning-tree bpdufilter enable
!
interface Vlan200
   ip address 192.168.200.14/24
   ipv6 address 2001:db8:200::14/64
!
