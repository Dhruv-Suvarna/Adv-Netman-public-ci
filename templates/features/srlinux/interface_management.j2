! MANAGEMENT / STATIC - AUTO and DHCP are prohibited
! mgmt0 belongs to the built-in "mgmt" network-instance, not "default"
set interface {{ name }} admin-state {{ "disable" if admin_disabled else "enable" }}
{% if description %}set interface {{ accepted_name }} description {{ description | tojson }}
{% endif %}
set interface {{ accepted_name }} subinterface 0 admin-state enable
set network-instance mgmt interface {{ accepted_name }}.0
